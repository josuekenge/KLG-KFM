# ==================================
# ENVIRONMENT CONFIGURATION
# ==================================
# Copy this file to .env.local for local development
# Copy this file to .env.production for production deployment

NODE_ENV="development"  # Options: development, production, test

# ==================================
# APP CONFIGURATION
# ==================================
NEXT_PUBLIC_APP_NAME="Kyeto Logistics Group"

# Development URL (use localhost)
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Production URL (uncomment and use this for production deployment)
# NEXT_PUBLIC_APP_URL="https://kyetologistics.com"

# ==================================
# ANALYTICS & MONITORING
# ==================================
# Google Analytics Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Google Tag Manager ID (optional)
NEXT_PUBLIC_GTM_ID=""

# Hotjar Site ID (optional)
NEXT_PUBLIC_HOTJAR_ID=""

# ==================================
# WEB3FORMS CONFIGURATION
# ==================================
# Required for contact form functionality
# Get your free API key at: https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=""

# ==================================
# BROWSER OPTIMIZATION
# ==================================
# Enable/disable browser-specific optimizations
NEXT_PUBLIC_BROWSER_OPTIMIZATION="true"

# Enable/disable performance monitoring
NEXT_PUBLIC_PERFORMANCE_MONITORING="true"

# ==================================
# API CONFIGURATION
# ==================================
# Internal API URL (if using Next.js API routes)
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# API Secret Key for server-side operations
API_SECRET_KEY=""

# ==================================
# DATABASE CONFIGURATION (Optional)
# ==================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=""

# Database pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# ==================================
# EMAIL CONFIGURATION (Optional)
# ==================================
# SMTP settings for sending emails
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ==================================
# THIRD-PARTY SERVICES (Optional)
# ==================================
# Mapbox API token for maps functionality
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Stripe keys (if implementing payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ==================================
# SECURITY CONFIGURATION
# ==================================
# JWT secret for authentication (generate a strong random string)
JWT_SECRET=""

# Session secret
SESSION_SECRET=""

# CORS allowed origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ==================================
# REDIS CONFIGURATION (Optional)
# ==================================
# For caching and session storage
REDIS_URL=""
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# ==================================
# CLOUDFLARE CONFIGURATION (Optional)
# ==================================
# Cloudflare API credentials for DNS/CDN management
CLOUDFLARE_API_KEY=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_EMAIL=""

# ==================================
# AWS CONFIGURATION (Optional)
# ==================================
# For S3 storage, SES emails, etc.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# ==================================
# FEATURE FLAGS
# ==================================
# Enable/disable features for testing
NEXT_PUBLIC_ENABLE_ANALYTICS="true"
NEXT_PUBLIC_ENABLE_CHAT="false"
NEXT_PUBLIC_ENABLE_NOTIFICATIONS="true"

# ==================================
# DEVELOPMENT TOOLS
# ==================================
# Enable React Query Devtools in development
NEXT_PUBLIC_ENABLE_DEVTOOLS="true"

# Enable verbose logging
NEXT_PUBLIC_ENABLE_LOGGING="false"

# ==================================
# NOTES
# ==================================
# 1. For LOCAL DEVELOPMENT:
#    - Use http://localhost:3001
#    - No SSL certificate needed
#    - Relaxed security headers
#
# 2. For PRODUCTION:
#    - Use https://your-domain.com
#    - SSL certificate required (Let's Encrypt recommended)
#    - Strict security headers enabled
#    - Set NODE_ENV="production"
#
# 3. SECURITY:
#    - Never commit .env.local or .env.production to version control
#    - Keep API keys and secrets secure
#    - Use different keys for development and production
#    - Rotate secrets regularly
#
# 4. SSL/HTTPS Setup:
#    - See DEPLOYMENT.md for detailed SSL configuration
#    - Use Let's Encrypt for free SSL certificates
#    - Configure DNS before requesting SSL
#    - Allow 24-48 hours for DNS propagation

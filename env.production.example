# Production Environment Configuration
# Copy this to .env.local and update with your actual values

# App Configuration
NEXT_PUBLIC_APP_NAME="Kyeto Logistics Group"
NEXT_PUBLIC_APP_URL="https://kyetologistics.com"

# Analytics (Production)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_HOTJAR_ID=""

# Web3Forms Configuration (for contact form)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY="your_web3forms_access_key_here"

# API Configuration
NEXT_PUBLIC_API_URL="https://api.kyetofleet.com"
API_SECRET_KEY="your_api_secret_key"

# Database (Production)
DATABASE_URL="postgresql://username:password@host:port/database"

# Email Configuration (Production)
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="587"
SMTP_USER="your-email@kyetofleet.com"
SMTP_PASS="your-email-password"

# Third-party Services (Production)
NEXT_PUBLIC_MAPBOX_TOKEN="your_mapbox_token"
NEXT_PUBLIC_SENTRY_DSN="your_sentry_dsn"

# Cross-browser optimizations
NEXT_PUBLIC_BROWSER_OPTIMIZATION="true"
NEXT_PUBLIC_PERFORMANCE_MONITORING="true"

# Security
NEXTAUTH_SECRET="your_nextauth_secret"
NEXTAUTH_URL="https://kyetofleet.com"

# CDN Configuration
NEXT_PUBLIC_CDN_URL="https://cdn.kyetofleet.com"

# Monitoring
NEXT_PUBLIC_MONITORING_ENABLED="true"
NEXT_PUBLIC_ERROR_REPORTING="true"

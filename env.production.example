# ==================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==================================
# Copy this file to .env.production for production deployment
# NEVER commit .env.production to version control!

NODE_ENV="production"

# ==================================
# APP CONFIGURATION
# ==================================
NEXT_PUBLIC_APP_NAME="Kyeto Logistics Group"
NEXT_PUBLIC_APP_URL="https://kyetologistics.com"

# ==================================
# ANALYTICS & MONITORING (Required)
# ==================================
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_HOTJAR_ID=""

# ==================================
# WEB3FORMS (Required)
# ==================================
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY="your-production-key-here"

# ==================================
# BROWSER OPTIMIZATION
# ==================================
NEXT_PUBLIC_BROWSER_OPTIMIZATION="true"
NEXT_PUBLIC_PERFORMANCE_MONITORING="true"

# ==================================
# API CONFIGURATION
# ==================================
NEXT_PUBLIC_API_URL="https://kyetologistics.com/api"
API_SECRET_KEY="your-secure-secret-key-here"

# ==================================
# DATABASE (If using)
# ==================================
DATABASE_URL="postgresql://user:password@production-host:5432/kfm_production"
DB_POOL_MIN=5
DB_POOL_MAX=20

# ==================================
# EMAIL CONFIGURATION (Production SMTP)
# ==================================
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="your-sendgrid-api-key"
SMTP_FROM="noreply@kyetologistics.com"

# ==================================
# THIRD-PARTY SERVICES
# ==================================
NEXT_PUBLIC_MAPBOX_TOKEN=""
NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
SENTRY_AUTH_TOKEN=""

# Stripe (If implementing payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_xxx"
STRIPE_SECRET_KEY="sk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ==================================
# SECURITY (Generate strong random strings!)
# ==================================
JWT_SECRET="your-super-secure-jwt-secret-minimum-32-characters"
SESSION_SECRET="your-super-secure-session-secret-minimum-32-characters"
CORS_ORIGINS="https://kyetologistics.com,https://www.kyetologistics.com"

# ==================================
# REDIS (For production caching)
# ==================================
REDIS_URL="redis://default:password@redis-production:6379"
REDIS_HOST="redis-production.example.com"
REDIS_PORT="6379"
REDIS_PASSWORD="your-redis-password"

# ==================================
# CLOUDFLARE (If using)
# ==================================
CLOUDFLARE_API_KEY="your-api-key"
CLOUDFLARE_ZONE_ID="your-zone-id"
CLOUDFLARE_EMAIL="your-email@example.com"

# ==================================
# AWS (If using)
# ==================================
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="kfm-production-assets"

# ==================================
# FEATURE FLAGS
# ==================================
NEXT_PUBLIC_ENABLE_ANALYTICS="true"
NEXT_PUBLIC_ENABLE_CHAT="true"
NEXT_PUBLIC_ENABLE_NOTIFICATIONS="true"

# ==================================
# PRODUCTION TOOLS
# ==================================
NEXT_PUBLIC_ENABLE_DEVTOOLS="false"
NEXT_PUBLIC_ENABLE_LOGGING="true"

# ==================================
# SSL/TLS CONFIGURATION
# ==================================
# These are typically managed by your hosting platform or web server
# If self-hosting, ensure SSL certificates are properly configured

# Let's Encrypt certificate paths (if self-hosted)
# SSL_CERT_PATH="/etc/letsencrypt/live/kyetologistics.com/fullchain.pem"
# SSL_KEY_PATH="/etc/letsencrypt/live/kyetologistics.com/privkey.pem"

# ==================================
# PRODUCTION SECURITY NOTES
# ==================================
# 1. SSL/TLS Certificate Required
#    - Use Let's Encrypt (free): certbot --nginx -d kyetologistics.com
#    - Or Cloudflare (automatic SSL)
#    - Or commercial SSL provider
#
# 2. DNS Configuration
#    - A record: @ → your-server-ip
#    - A record: www → your-server-ip
#    - CNAME: * → kyetologistics.com
#
# 3. Firewall Rules
#    - Allow port 443 (HTTPS)
#    - Allow port 80 (HTTP - for redirect to HTTPS)
#    - Block all other incoming ports
#
# 4. Security Headers (configured in next.config.ts)
#    - HSTS enabled
#    - CSP strict mode
#    - X-Frame-Options: DENY
#    - X-Content-Type-Options: nosniff
#
# 5. Environment Variables Security
#    - Never commit this file to git
#    - Use secrets management (AWS Secrets Manager, Azure Key Vault, etc.)
#    - Rotate secrets regularly
#    - Use different keys for staging and production
#
# 6. Monitoring & Logging
#    - Set up UptimeRobot for uptime monitoring
#    - Configure Sentry for error tracking
#    - Enable production logging
#    - Set up alerts for critical errors
#
# 7. Backups
#    - Database: Daily automated backups
#    - File storage: Replicated across regions
#    - Configuration: Stored in secure location
#
# 8. Rate Limiting
#    - Configure at CDN level (Cloudflare)
#    - Or use API Gateway rate limiting
#    - Protect contact form from spam
